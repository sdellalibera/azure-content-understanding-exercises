{
  "description": "Analyzer per fatture - Esercizio 1. Riferimento campi da definire nel portale Content Understanding (template Document).",
  "baseAnalyzerId": "prebuilt-documentAnalyzer",
  "config": {
    "returnDetails": true,
    "enableGrounding": true,
    "enableConfidence": true
  },
  "fieldSchema": {
    "fields": {
      "vendor_name":        { "type": "string",  "method": "extract",  "description": "Nome del fornitore/emittente della fattura" },
      "invoice_id":         { "type": "string",  "method": "extract",  "description": "Numero/ID della fattura" },
      "invoice_date":       { "type": "date",    "method": "extract",  "description": "Data di emissione" },
      "invoice_total":      { "type": "number",  "method": "extract",  "description": "Importo totale della fattura" },
      "currency":           { "type": "string",  "method": "extract",  "description": "Valuta (es. USD, EUR)" },
      "line_items": {
        "type": "array",
        "method": "extract",
        "description": "Righe di dettaglio della fattura",
        "items": {
          "type": "object",
          "properties": {
            "description": { "type": "string", "description": "Descrizione articolo" },
            "quantity":    { "type": "number", "description": "Quantita" },
            "unit_price":  { "type": "number", "description": "Prezzo unitario" },
            "amount":      { "type": "number", "description": "Importo di riga" }
          }
        }
      },
      "payment_terms_days": { "type": "integer", "method": "generate", "description": "Giorni di pagamento dedotti dai termini (es. 'Net 30' -> 30)" },
      "is_overdue":         { "type": "boolean", "method": "generate", "description": "True se la fattura risulta scaduta rispetto alla data odierna" },
      "risk_note":          { "type": "string",  "method": "generate", "description": "Breve nota se mancano dati chiave (totale o data)" }
    }
  }
}
