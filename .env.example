# Endpoint della RISORSA Foundry, non del progetto.
AZURE_CONTENTUNDERSTANDING_ENDPOINT=https://<risorsa>.services.ai.azure.com/
AZURE_CONTENTUNDERSTANDING_API_KEY=<api-key-content-understanding>

# Percorso relativo alla root della repo. Su Windows usare / o backslash singoli.
DOCUMENT_PATH=esercizi/documenti/sample_hotel_bill_mario_rossi.pdf

# Solo per gli esercizi 5 e 6: endpoint PROGETTO e nome del deployment chat.
# Il modello usa Microsoft Entra ID tramite "az login", NON la API key CU.
FOUNDRY_PROJECT_ENDPOINT=https://<risorsa>.services.ai.azure.com/api/projects/<progetto>
FOUNDRY_MODEL=<nome-deployment-chat>
